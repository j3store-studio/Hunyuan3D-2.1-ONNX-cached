{
  "tests": [
    {
      "name": "basic_3d_generation",
      "input": {
        "image_base64": "TEST_IMAGE_BASE64_HERE",
        "generate_texture": false,
        "output_format": "glb",
        "num_views": 4,
        "texture_resolution": 256
      },
      "timeout": 600000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA RTX A6000",
    "gpuCount": 1,
    "containerDiskInGb": 50,
    "env": [
      {
        "key": "MAX_NUM_VIEW",
        "value": "6"
      },
      {
        "key": "TEXTURE_RESOLUTION",
        "value": "512"
      }
    ],
    "allowedCudaVersions": ["12.4", "12.3", "12.2", "12.1", "12.0"]
  }
}
